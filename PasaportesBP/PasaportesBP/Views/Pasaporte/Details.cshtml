@model PasaportesBP.Models.Pasaporte

@{
    ViewData["Title"] = "Detalle de Pasaporte";
}

<h1>Detalle de Pasaporte</h1>

<div class="mb-3">
    <strong>Número:</strong> @Model.NumeroPasaporte
</div>
<div class="mb-3">
    <strong>Solicitante:</strong> @Model.Solicitante?.NombreCompleto
</div>
<div class="mb-3">
    <strong>Estado:</strong> @Model.Estado
</div>
<div class="mb-3">
    <strong>Fecha Solicitud:</strong> @Model.FechaSolicitud.ToShortDateString()
</div>
<div class="mb-3">
    <strong>Fecha Aprobación:</strong> @(Model.FechaAprobacion.HasValue ? Model.FechaAprobacion.Value.ToShortDateString() : "-")
</div>
<div class="mb-3">
    <strong>Fecha Entrega:</strong> @(Model.FechaEntrega.HasValue ? Model.FechaEntrega.Value.ToShortDateString() : "-")
</div>

<a asp-action="Editar" asp-route-id="@Model.PasaporteID" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
