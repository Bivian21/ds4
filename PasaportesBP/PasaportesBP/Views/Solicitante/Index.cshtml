@model IEnumerable<PasaportesBP.Models.Solicitante>

@{
    ViewData["Title"] = "Solicitantes";
}

<h1>Solicitantes</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Nuevo Solicitante</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Cédula</th>
            <th>Nombre Completo</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.Cedula</td>
            <td>@s.Nombres @s.Apellidos</td>
            <td>@s.Telefono</td>
            <td>@s.Email</td>
            <td>
                <a asp-action="Details" asp-route-id="@s.SolicitanteID" class="btn btn-sm btn-info">Detalle</a>
                <a asp-action="Editar" asp-route-id="@s.SolicitanteID" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Eliminar" asp-route-id="@s.SolicitanteID" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
