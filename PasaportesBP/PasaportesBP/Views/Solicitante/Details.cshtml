@model PasaportesBP.Models.Solicitante

@{
    ViewData["Title"] = "Detalle de Solicitante";
}

<h1>Detalle de Solicitante</h1>

<div class="mb-3">
    <strong>Cédula:</strong> @Model.Cedula
</div>
<div class="mb-3">
    <strong>Nombre:</strong> @Model.Nombres @Model.Apellidos
</div>
<div class="mb-3">
    <strong>Fecha de nacimiento:</strong> @Model.FechaNacimiento.ToShortDateString()
</div>
<div class="mb-3">
    <strong>Dirección:</strong> @Model.Direccion
</div>
<div class="mb-3">
    <strong>Teléfono:</strong> @Model.Telefono
</div>
<div class="mb-3">
    <strong>Email:</strong> @Model.Email
</div>

<a asp-action="Editar" asp-route-id="@Model.SolicitanteID" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
