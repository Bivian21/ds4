@model Estudiante
@{
    ViewData["Title"] = "Eliminar Estudiante";
    ViewBag.Subtitle = Model.NombreCompleto;
}
<div class="card card-soft">
    <div class="card-body">
        <p>¿Seguro que desea eliminar a <b>@Model.NombreCompleto</b> (Cédula: @Model.Cedula)?</p>
        <form method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger" type="submit">Sí, eliminar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>
