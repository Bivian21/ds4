@model IEnumerable<Profesor>
@{
    ViewData["Title"] = "Profesores";
    ViewBag.Subtitle = "Gestión de docentes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <form class="d-flex gap-2" method="get">
        <input class="form-control" name="q" value="@ViewBag.Q" placeholder="Buscar por cédula o nombre..." />
        <button class="btn btn-outline-secondary">Buscar</button>
    </form>
    <a class="btn btn-primary" asp-action="Create">+ Nuevo</a>
</div>

<div class="card card-soft">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
            <tr>
                <th>Cédula</th>
                <th>Nombre</th>
                <th>Especialidad</th>
                <th>Activo</th>
                <th class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Cedula</td>
                    <td>@p.NombreCompleto</td>
                    <td>@p.Especialidad</td>
                    <td>@(p.Activo ? "Sí" : "No")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.Id">Eliminar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
