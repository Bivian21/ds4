@model Grupo
@{
    ViewData["Title"] = "Eliminar Grupo";
    ViewBag.Subtitle = $"{Model.Grado}-{Model.Seccion}";
}
<div class="card card-soft">
    <div class="card-body">
        <p>¿Seguro que desea eliminar el grupo <b>@Model.Grado-@Model.Seccion</b> de <b>@Model.Materia?.Codigo</b>?</p>
        <form method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger" type="submit">Sí, eliminar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>
