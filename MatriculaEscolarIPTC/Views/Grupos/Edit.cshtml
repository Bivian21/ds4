@model Grupo
@{
    ViewData["Title"] = "Editar Grupo";
    ViewBag.Subtitle = $"{Model.Grado}-{Model.Seccion}";
}
<div class="card card-soft">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Periodo</label>
                    <input class="form-control" asp-for="Periodo" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Grado</label>
                    <input class="form-control" asp-for="Grado" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Sección</label>
                    <input class="form-control" asp-for="Seccion" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Cupo</label>
                    <input class="form-control" asp-for="Cupo" type="number" min="1" max="60" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Materia</label>
                    <select class="form-select" asp-for="MateriaId" asp-items="ViewBag.Materias"></select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Profesor</label>
                    <select class="form-select" asp-for="ProfesorId" asp-items="ViewBag.Profesores"></select>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Guardar cambios</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
            </div>
        </form>
    </div>
</div>
