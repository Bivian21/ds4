@model IEnumerable<Grupo>
@{
    ViewData["Title"] = "Grupos / Secciones";
    ViewBag.Subtitle = "Oferta de materias por periodo";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <form class="row g-2 align-items-center" method="get">
        <div class="col-auto">
            <input class="form-control" name="periodo" value="@ViewBag.Periodo" placeholder="Periodo (ej. II-2025)" />
        </div>
        <div class="col-auto">
            <input class="form-control" name="grado" value="@ViewBag.Grado" placeholder="Grado (ej. 7°)" />
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-secondary">Filtrar</button>
        </div>
    </form>
    <a class="btn btn-primary" asp-action="Create">+ Nuevo</a>
</div>

<div class="card card-soft">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
            <tr>
                <th>Periodo</th>
                <th>Grado-Sección</th>
                <th>Materia</th>
                <th>Profesor</th>
                <th>Cupo</th>
                <th class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var g in Model)
            {
                <tr>
                    <td>@g.Periodo</td>
                    <td><span class="badge text-bg-light">@g.Grado-@g.Seccion</span></td>
                    <td><b>@g.Materia?.Codigo</b> - @g.Materia?.Nombre</td>
                    <td>@g.Profesor?.NombreCompleto</td>
                    <td>@g.Cupo</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@g.Id">Ver</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@g.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@g.Id">Eliminar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
