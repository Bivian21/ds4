@model Materia
@{
    ViewData["Title"] = "Editar Materia";
    ViewBag.Subtitle = Model.Codigo;
}
<div class="card card-soft">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Código</label>
                    <input class="form-control" asp-for="Codigo" />
                    <span class="text-danger" asp-validation-for="Codigo"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" asp-for="Nombre" />
                    <span class="text-danger" asp-validation-for="Nombre"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Créditos</label>
                    <input class="form-control" asp-for="Creditos" type="number" min="1" max="10" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Activa" />
                        <label class="form-check-label" asp-for="Activa">Activa</label>
                    </div>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Guardar cambios</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
