@model Matricula
@{
    ViewData["Title"] = "Nueva Matrícula";
    ViewBag.Subtitle = "Seleccionar estudiante y periodo";
    var estudiantes = ViewBag.Estudiantes as List<Estudiante>;
}
<div class="card card-soft">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">Estudiante</label>
                    <select class="form-select" asp-for="EstudianteId" required>
                        <option value="">-- Seleccione --</option>
                        @foreach (var e in estudiantes!)
                        {
                            <option value="@e.Id">@e.NombreCompleto (@e.Cedula) - @e.Grado</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Periodo</label>
                    <input class="form-control" asp-for="Periodo" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Crear</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>
