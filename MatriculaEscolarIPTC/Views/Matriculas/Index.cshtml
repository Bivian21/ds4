@model IEnumerable<Matricula>
@{
    ViewData["Title"] = "Matrículas";
    ViewBag.Subtitle = "Registro y comprobantes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <form class="row g-2 align-items-center" method="get">
        <div class="col-auto">
            <input class="form-control" name="periodo" value="@ViewBag.Periodo" placeholder="Periodo (ej. II-2025)" />
        </div>
        <div class="col-auto">
            <input class="form-control" name="q" value="@ViewBag.Q" placeholder="Buscar estudiante..." />
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-secondary">Filtrar</button>
        </div>
    </form>
    <a class="btn btn-primary" asp-action="Create">+ Nueva</a>
</div>

<div class="card card-soft">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
            <tr>
                <th>Fecha</th>
                <th>Periodo</th>
                <th>Estudiante</th>
                <th>Materias</th>
                <th class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span class="badge text-bg-light">@m.Periodo</span></td>
                    <td>@m.Estudiante?.NombreCompleto <div class="small text-muted">@m.Estudiante?.Cedula</div></td>
                    <td>@(m.Detalles?.Count ?? 0)</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Pdf" asp-action="Comprobante" asp-route-id="@m.Id">PDF</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.Id">Abrir</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@m.Id">Eliminar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
